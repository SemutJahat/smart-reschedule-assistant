{
  "name": "smart-reschedule-assistant-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.22",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
