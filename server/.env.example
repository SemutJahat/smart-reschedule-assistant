# Local development defaults; replace credentials and secrets for any shared environment.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymnasyum
JWT_SECRET=replace-with-a-development-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-development-secret-at-least-32-characters
SEED_ADMIN_PASSWORD=replace-with-admin-seed-password
SEED_CUSTOMER_PASSWORD=replace-with-customer-seed-password
